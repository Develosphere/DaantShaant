# ============================================================
# DaantShaant Environment Configuration
# ============================================================
#
# This file contains SAFE PLACEHOLDERS ONLY.
# Never commit real passwords, API keys, JWT secrets, or DB URLs.
#
# Copy to .env / service-specific environment configuration
# and replace values locally or in deployment secret storage.
# ============================================================


# ============================================================
# Application
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# Frontend URL used for CORS / redirects where required
APP_FRONTEND_URL=http://localhost:3000

# Comma-separated origins if the backend config supports this format
CORS_ORIGINS=http://localhost:3000


# ============================================================
# Orchestrator — FastAPI (port 8000)
# ============================================================

ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000

ORCHESTRATOR_TEETH_ANALYZER_URL=http://127.0.0.1:8001
ORCHESTRATOR_DIAGNOSIS_URL=http://127.0.0.1:8002

# Existing real-time WebSocket dental scan controls
ORCHESTRATOR_LIVE_MAX_FPS=1
ORCHESTRATOR_LIVE_MAX_ANALYSES_PER_SESSION=8

# Optional maximum live session duration
ORCHESTRATOR_LIVE_MAX_SESSION_SECONDS=120


# ============================================================
# Teeth Analyzer Service — port 8001
# ============================================================

TEETH_ANALYZER_HOST=0.0.0.0
TEETH_ANALYZER_PORT=8001

# Technical quality gate behavior
TEETH_ANALYZER_REJECT_LOW_QUALITY=false


# ============================================================
# Diagnosis / Clinical Rule Service — port 8002
# ============================================================

DIAGNOSIS_HOST=0.0.0.0
DIAGNOSIS_PORT=8002


# ============================================================
# Supabase PostgreSQL
# ============================================================
#
# Supabase is used primarily as managed PostgreSQL hosting.
#
# Core persistence architecture:
#
# FastAPI
#   -> SQLAlchemy 2 async
#   -> asyncpg
#   -> DATABASE_URL
#   -> Supabase PostgreSQL
#
# Recommended runtime:
# - direct PostgreSQL connection where IPv6 is available
# - OR Supavisor Session Pooler on port 5432 for IPv4 environments
#
# Recommended migrations:
# - direct PostgreSQL connection where reachable
# - otherwise Session Pooler :5432
#
# Do NOT use the transaction pooler :6543 as the default for this
# persistent FastAPI backend.
# ============================================================

DATABASE_URL=
DATABASE_MIGRATION_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800


# ============================================================
# Supabase Project API
# ============================================================
#
# These are NOT required for ordinary SQLAlchemy database access.
#
# They are included for future Supabase services such as:
# - Storage
# - Realtime
# - server-side Supabase APIs
#
# SUPABASE_SECRET_KEY must remain SERVER-SIDE ONLY.
# Never expose it using NEXT_PUBLIC_*.
# ============================================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


# ============================================================
# Authentication
# ============================================================
#
# Target auth architecture:
# - short-lived access JWT
# - opaque rotating refresh token
# - refresh-token hash persisted in PostgreSQL
# - HttpOnly refresh cookie
# - access token kept in frontend memory only
# ============================================================

JWT_SECRET=
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_REFRESH_COOKIE_NAME=daantshaant_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# Optional in production when explicitly needed
AUTH_COOKIE_DOMAIN=


# ============================================================
# DaantShaant AI Gateway
# ============================================================
#
# Primary:
# Alibaba Cloud Model Studio / Qwen
#
# Fallback:
# Google Gemini
#
# Business modules must eventually use the shared AI gateway rather
# than importing providers directly.
# ============================================================

PRIMARY_AI_PROVIDER=qwen
FALLBACK_AI_PROVIDER=gemini

AI_REQUEST_TIMEOUT_SECONDS=60


# ============================================================
# Alibaba Cloud Model Studio / Qwen
# ============================================================
#
# API key created in Alibaba Cloud Model Studio.
#
# Example workspace base URL shape:
# https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#
# Use the base URL ending in /v1.
# Do NOT append /chat/completions.
# ============================================================

DASHSCOPE_API_KEY=

QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Verified default model
QWEN_DEFAULT_MODEL=qwen3.7-plus

# Task-specific aliases.
# They may initially all use qwen3.7-plus and can later be tuned independently.
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_RELEVANCE_MODEL=qwen3.7-plus
QWEN_REASONING_MODEL=qwen3.7-plus
QWEN_CHAT_MODEL=qwen3.7-plus


# ============================================================
# Google Gemini — Technical Fallback
# ============================================================
#
# Gemini is NOT the default provider.
# It is retained as technical fallback and possible future second opinion.
# ============================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest


# ============================================================
# Dental RAG
# ============================================================
#
# Existing technology:
# sentence-transformers + FAISS
#
# These values may be refined during the Clinical RAG upgrade phase.
# ============================================================

RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_DOCUMENTS_DIR=./data/rag/documents
RAG_INDEX_DIR=./data/rag/index

RAG_TOP_K=5


# ============================================================
# Dental Scan / Media
# ============================================================
#
# Current existing scan modes:
# - snapshot
# - upload
# - live WebSocket
#
# Storage strategy may later use Supabase Storage or another object
# storage provider. Do not configure a public patient-image bucket here.
# ============================================================

SCAN_MAX_IMAGE_MB=10


# ============================================================
# Dentist Discovery / Open Map Stack
# ============================================================
#
# Google Maps / Google Places are being removed.
#
# Target:
# - MapLibre GL JS
# - OpenFreeMap
# - OpenStreetMap
# - Overpass API
# ============================================================

OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Official OpenFreeMap Liberty style
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Community dentist cache lifetime
DENTIST_DISCOVERY_CACHE_HOURS=24

# Default discovery radius
DENTIST_SEARCH_RADIUS_KM=15

# Optional maximum radius when expanding search
DENTIST_SEARCH_MAX_RADIUS_KM=50


# ============================================================
# Next.js Frontend
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ORCHESTRATOR_WS=ws://127.0.0.1:8000


# ============================================================
# Optional Supabase Frontend API
# ============================================================
#
# DO NOT add these unless the frontend later intentionally uses
# Supabase Data API / Storage / Realtime directly.
#
# Never create NEXT_PUBLIC_SUPABASE_SECRET_KEY.
# ============================================================

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ============================================================
# Development / Testing
# ============================================================

TESTING=false