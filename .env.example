# Orchestrator (port 8000)
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_TEETH_ANALYZER_URL=http://127.0.0.1:8001
ORCHESTRATOR_DIAGNOSIS_URL=http://127.0.0.1:8002
ORCHESTRATOR_LIVE_MAX_FPS=1
ORCHESTRATOR_LIVE_MAX_ANALYSES_PER_SESSION=8

# Teeth Analyzer (port 8001)
TEETH_ANALYZER_PORT=8001
TEETH_ANALYZER_BACKEND=gemini
TEETH_ANALYZER_FALLBACK_TO_STUB=false
TEETH_ANALYZER_GEMINI_API_KEY=your_gemini_api_key_here
TEETH_ANALYZER_GEMINI_MODEL=gemini-flash-lite-latest
TEETH_ANALYZER_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
TEETH_ANALYZER_OPENROUTER_API_KEY=your_openrouter_api_key_here
TEETH_ANALYZER_OPENROUTER_MODEL=openrouter/free
TEETH_ANALYZER_REJECT_LOW_QUALITY=false

# Diagnosis (port 8002)
DIAGNOSIS_PORT=8002

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dantshaant

# OpenRouter (for conversational AI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Next.js
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ORCHESTRATOR_WS=ws://127.0.0.1:8000

# Dentist Portal + Recommendation AI (uses TEETH_ANALYZER_GEMINI_* above — no OpenAI needed)
PORTAL_JWT_SECRET=dantshaant-portal-secret-change-in-prod
