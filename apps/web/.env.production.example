# ==============================================================================
# DaantShaant Frontend Production Environment Template
#
# Production domain: https://daantshaant.codemelodies.com
# Copy to apps/web/.env.production on the VPS.
# ==============================================================================

# Browser-facing Orchestrator REST API (proxied via Apache at /backend/)
NEXT_PUBLIC_ORCHESTRATOR_URL=https://daantshaant.codemelodies.com/backend

# Browser-facing Orchestrator WebSocket (proxied via Apache at /backend/ws/)
NEXT_PUBLIC_ORCHESTRATOR_WS=wss://daantshaant.codemelodies.com/backend

# Optional client-side keys (if applicable)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
